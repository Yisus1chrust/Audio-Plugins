# Auto detect text files and perform LF normalization
* text=auto

# C++ sources
*.cpp text diff=cpp
*.h text diff=cpp
*.hpp text diff=cpp

# CMake
CMakeLists.txt text
*.cmake text

# Documentation
*.md text
*.txt text

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.vst3 binary
*.component binary
